# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — unanchored so they match under frontend/ (and backend/) too,
# not just at the repo root
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Large video assets — add locally, do not commit
frontend/public/videos/*.mp4
frontend/public/videos/*.webm
frontend/public/videos/*.mov
