# Copy to backend/.env for local dev. Read by core/config.py (Settings) via
# python-dotenv — every field here maps 1:1 to a Settings attribute.

ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Supabase — provisioned via the Vercel Marketplace integration
# (`vercel integration add supabase`). Get these from `vercel env pull`
# at the repo root (writes .env.local) or the Supabase dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only used by ad-hoc scripts that sign in as a test user to exercise
# auth'd endpoints (e.g. casting a vote) — no frontend auth UI yet.
SUPABASE_ANON_KEY=

# NOT read from this file — migrations connect directly via psycopg2 using
# SUPABASE_DB_URL, exported as a real environment variable at migration time
# (a deployment secret, never committed): use the POSTGRES_URL_NON_POOLING
# value from `vercel env pull`, e.g.:
#   export SUPABASE_DB_URL="$POSTGRES_URL_NON_POOLING" && python -m migrate
