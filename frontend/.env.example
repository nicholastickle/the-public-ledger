# Copy to frontend/.env.local for local dev.

# FastAPI backend URL — the only env var the frontend actually reads today
# (src/app/lib/api.ts). Falls back to this same value if unset, so it's
# optional for local dev, but set explicitly in the Vercel dashboard for
# deployed environments (there is no live backend deployment yet).
BACKEND_URL=http://localhost:8000

# Supabase — already provisioned via the Vercel Marketplace integration and
# auto-injected into this project's Vercel environment (`vercel env pull`
# writes the real values here, plus POSTGRES_*/SUPABASE_* server-side
# variants not needed by the frontend). Reserved for the frontend's own
# Supabase Auth client — not consumed by any code yet, since there's no
# sign-up/login UI or src/app/api/auth/ route built yet (see CLAUDE.md's
# Auth section).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
